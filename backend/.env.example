# ===== 通用 =====
EMOERA_ENVIRONMENT=development
EMOERA_CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080
# 定时任务（默认关闭；设为 true 后每天在指定时刻自动跑每日任务）
EMOERA_ENABLE_SCHEDULER=false
EMOERA_DAILY_TASK_HOUR=9
EMOERA_DAILY_TASK_MINUTE=0

# ===== AI 每日速报（OpenAI 兼容接口，可在网站「设置」页运行时修改）=====
# base_url 示例：DeepSeek https://api.deepseek.com/v1，OpenAI https://api.openai.com/v1
# 留空时使用默认值 https://api.openai.com/v1
EMOERA_AI_BASE_URL=
EMOERA_AI_MODEL=gpt-4o-mini
EMOERA_AI_API_KEY=

# ===== 安全：设置管理令牌（强烈建议公网部署时配置）=====
# 留空 = 不启用鉴权（适合本地/内网）；设置后，「设置」页所有写操作与
# 「自动获取模型」都需携带该令牌，防止 API Key 被外部窃取或配置被篡改。
EMOERA_ADMIN_TOKEN=

# ===== 安全：管理员邀请码（注册时填此码成为管理员）=====
# 留空 = 无法创建管理员（平台无管理员入口，安全默认）
EMOERA_ADMIN_INVITE_CODE=

# ===== 安全：SSRF 防护 =====
# 设为 true 放行内网 base_url（本地调试 Ollama / LM Studio 用）；默认禁止内网防 SSRF
EMOERA_ALLOW_PRIVATE=false

# ===== 安全：限流与滥用防护 =====
# 是否启用写操作限流（POST/PUT/DELETE 按 IP 计数）
EMOERA_ENABLE_RATE_LIMIT=true
# 写操作每分钟每 IP 上限（登录/注册接口另有更严格的 20 次/分）
EMOERA_RATE_LIMIT_BURST=120
# 请求体大小上限（字节；附件上传接口豁免，文件大小由 MAX_FILE_SIZE 独立校验）
EMOERA_MAX_BODY_BYTES=16777216

# ===== 安全：是否信任 X-Forwarded-For =====
# 仅当部署在可信反向代理（Nginx/Cloudflare 等）后方时设为 true。
# 默认 false：否则攻击者伪造 XFF 头即可绕过限流（务必配合 --no-proxy-headers 启动）
EMOERA_TRUST_PROXY=false

# ===== 社交媒体（浏览器自动化，留空 = demo 模式）=====
EMOERA_WEIBO_USERNAME=
EMOERA_WEIBO_PASSWORD=
EMOERA_XIAOHONGSHU_USERNAME=
EMOERA_XIAOHONGSHU_PASSWORD=
EMOERA_DOUYIN_USERNAME=
EMOERA_DOUYIN_PASSWORD=

# ===== GitHub（官方 API，推荐用 Personal Access Token）=====
EMOERA_GITHUB_TOKEN=

# ===== 邮件（IMAP，注意多数邮箱需用“授权码”而非登录密码）=====
EMOERA_EMAIL_IMAP_HOST=imap.qq.com
EMOERA_EMAIL_IMAP_PORT=993
EMOERA_EMAIL_USERNAME=
EMOERA_EMAIL_PASSWORD=
EMOERA_EMAIL_MAILBOX=INBOX
EMOERA_EMAIL_MAX=20
